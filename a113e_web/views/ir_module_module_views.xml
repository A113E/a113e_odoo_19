<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_filter_a113e_apps" model="ir.ui.view">
        <field name="name">ir.module.module.list.select.a113e.apps</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='app']" position="after">
                <filter
                    name="a113e_apps"
                    string="A113E"
                    domain="[('name', '=like', 'a113e_%')]"
                />
            </xpath>
        </field>
    </record>

    <record id="base.open_module_tree" model="ir.actions.act_window">
        <field name="context">{'search_default_a113e_apps': 1}</field>
    </record>
</odoo>
