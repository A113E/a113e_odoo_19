<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="eq_template_colors_form" model="ir.ui.view">
            <field name="name">eq.template.colors.form</field>
            <field name="model">eq.template.colors</field>
            <field name="arch" type="xml">
                <form string="Color Picker" class="oe_form_configuration">
                        <header>
                            <button
                            string="Apply"
                            type="object"
                            name="execute"
                            class="oe_highlight"
                        />
                            <button
                            string="Reset All Colors"
                            type="object"
                            name="reset_default"
                            class="oe_highlight"
                        />
                            <button
                            string="Discard"
                            type="object"
                            name="cancel"
                            special="cancel"
                        />
                        </header>
                        <sheet>
                        <group>
                            <group>
                                <field name="eq_color_template_id" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Light Mode" name="eq_light_mode">
                                <group>
                                    <group>
                                        <separator string="Basic Colors" />
                                        <field
                                            name="eq_basic_text_color"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_basic_secondary_color"
                                            widget="eq_color"
                                        />
                                        <field name="eq_link_color" widget="eq_color" />
                                    </group>
                                    <group name="eq_es_group_config">
                                        <separator string="Navigation" />
                                        <field name="eq_apps_color" widget="eq_color" />
                                        <field
                                            name="eq_navi_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_navi_fontcolor"
                                            widget="eq_color"
                                        />
                                        <field name="eq_navi_hover" widget="eq_color" />
                                        <field
                                            name="eq_navi_hover_fontcolor"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="Buttons" />
                                        <field
                                            name="eq_btn_primary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_btn_primary_fontcolor"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_btn_secondary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_btn_secondary_fontcolor"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="List View" />
                                        <field
                                            name="eq_list_primary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_list_secondary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_list_hoover_background"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="Background" />
                                        <field name="eq_company_id" invisible="1" />
                                        <field
                                            name="eq_background_image_name"
                                            invisible="1"
                                        />
                                        <field
                                            name="eq_background_image"
                                            filename="eq_background_image_name"
                                        />
                                    </group>
                                </group>
                            </page>
                            <page string="Dark Mode" name="eq_dark_mode">
                                <div class="alert alert-info" role="alert">
                                    These colors apply when a user switches the backend to dark mode
                                    via the user menu. Picking a color template fills them in
                                    automatically.
                                </div>
                                <group>
                                    <group>
                                        <separator string="Basic Colors" />
                                        <field
                                            name="eq_dark_view_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_basic_text_color"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_basic_secondary_color"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_link_color"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="Navigation" />
                                        <field
                                            name="eq_dark_apps_color"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_navi_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_navi_fontcolor"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_navi_hover"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_navi_hover_fontcolor"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="Buttons" />
                                        <field
                                            name="eq_dark_btn_primary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_btn_primary_fontcolor"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_btn_secondary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_btn_secondary_fontcolor"
                                            widget="eq_color"
                                        />
                                    </group>
                                    <group>
                                        <separator string="List View" />
                                        <field
                                            name="eq_dark_list_primary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_list_secondary_background"
                                            widget="eq_color"
                                        />
                                        <field
                                            name="eq_dark_list_hoover_background"
                                            widget="eq_color"
                                        />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="eq_template_colors_action" model="ir.actions.act_window">
                <field name="name">Template Colors</field>
                <field name="path">ownerp-template-colors</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">eq.template.colors</field>
                <field name="view_mode">form</field>
                <field name="target">current</field>
        </record>

        <menuitem
            id="eq_template_colors_menu"
            name="Template Colors"
            parent="base.menu_administration"
            sequence="2"
        />
        <menuitem
            id="eq_colors_menu"
            action="eq_template_colors_action"
            name="Colors"
            parent="eq_ownerp_ui.eq_template_colors_menu"
            sequence="1"
        />

    </data>
</odoo>
